#include <stdio.h>
#include <string.h>
#include <ctype.h>

char input[10];
int i, error;

void E();
void Eprime();
void T();
void Tprime();
void F();

int main()
{
    i = 0;
    error = 0;

    printf("E -> T Eprime\n");
    printf("Eprime -> + T Eprime / E\n");
    printf("T -> F Tprime\n");
    printf("Tprime -> * F Tprime / E\n");
    printf("F -> (E) / id\n");

    printf("Enter an arithmetic expression: ");
    scanf("%s", input);

    E();

    if (strlen(input) == i && error == 0)
        printf("\nAccepted...!!!\n");
    else
        printf("\nRejected...!!!\n");

    return 0;
}

void E()
{
    T();
    Eprime();
}

void Eprime()
{
    if (input[i] == '+')
    {
        i++;
        T();
        Eprime();
    }
}

void T()
{
    F();
    Tprime();
}

void Tprime()
{
    if (input[i] == '*')
    {
        i++;
        F();
        Tprime();
    }
}

void F()
{
    if (input[i] == '(')
    {
        i++;
        E();

        if (input[i] == ')')
            i++;
        else
            error = 1;
    }
    else if (isalnum(input[i]))
    {
        i++;
    }
    else
    {
        error = 1;
    }
}
