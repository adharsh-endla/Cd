%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%

[0-9]+ {
    yylval.num = atoi(yytext);
    return NUMBER;
}

"+" {
    return PLUS;
}

"-" {
    return MINUS;
}

"*" {
    return MULT;
}

"/" {
    return DIV;
}

"(" {
    return LPAREN;
}

")" {
    return RPAREN;
}

[\t\n] {
    /* ignore white-space */
}

. {
    printf("Invalid character: %s\n", yytext);
}

%%

int yywrap()
{
    return 1;
}
